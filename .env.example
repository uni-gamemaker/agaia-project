# Turso/libSQL database URL and token. Keep the token private; don't commit it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Tests always use a disposable local SQLite database, never the Turso production DB.
TEST_TURSO_DATABASE_URL=file:./ajaia-test.db

# Maximum upload size in bytes (default 1048576 = 1 MB).
MAX_UPLOAD_BYTES=1048576

# Session lifetime in days (default 7).
SESSION_TTL_DAYS=7

# Enables the demo account switcher at POST /api/auth/demo-login.
# Demo-only. Never enable this as a substitute for real authentication.
DEMO_MODE=false
